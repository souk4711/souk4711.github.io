---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, url, repo } = entry.data;
const { Content } = await render(entry);
---

<Layout title={title} description={summary}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <a href="/work" class="text-ink-soft hover:text-signal font-mono text-xs transition-colors">
      ← All work
    </a>

    <h1 class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl">
      {title}
    </h1>

    <div class="prose prose-sm sm:prose-base mt-6 max-w-2xl">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      {
        url && (
          <Button href={url} variant="solid">
            Visit live →
          </Button>
        )
      }
      {
        repo && (
          <Button href={repo} variant="ghost">
            View source
          </Button>
        )
      }
    </div>
  </article>
</Layout>
