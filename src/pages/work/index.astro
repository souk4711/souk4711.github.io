---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import WorkRow from '@/components/WorkRow.astro';

const allWork = (await getCollection('work')).sort(
  (a, b) => true
);
---

<Layout title="Work">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="All work" count={allWork.length} />
    <div>
      {allWork.map((entry) => <WorkRow entry={entry} />)}
    </div>
  </section>
</Layout>
