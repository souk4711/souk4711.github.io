---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="flex flex-col items-start mx-auto gap-4 max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">
      Page not found
    </p>

    <h1 class="font-display text-ink text-3xl font-medium mt-2">
      This page doesn't exist.
    </h1>

    <p class="text-ink-soft">
      The link might be broken, or the page may have moved.
    </p>

    <a href="/" class="text-signal font-mono text-sm mt-2 hover:underline">
      ← Back home
    </a>
  </section>
</Layout>
