---
const social = [
  { label: "GitHub", href: "https://github.com/souk4711" }
];
---

<footer class="border-line border-t">
  <div class="text-ink-soft mx-auto flex max-w-3xl flex-col gap-4 px-6 py-8 font-mono text-xs sm:flex-row sm:items-center sm:justify-between">
    <p>
      <a href="/404" class="hover:text-signal transition-colors">/404</a>
    </p>

    <nav class="flex items-center gap-4" aria-label="Social">
      {
        social.map((link) => (
          <a href={link.href} target="_blank" class="hover:text-signal transition-colors" rel="me">
            {link.label}
          </a>
        ))
      }
      <a href="#top" class="hover:text-signal transition-colors"> Top ↑ </a>
    </nav>
  </div>
</footer>
