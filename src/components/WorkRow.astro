---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary } = entry.data;
---

<a
  href={`/work/${entry.id}`}
  class="group border-line hover:border-signal grid grid-cols-[1fr_auto] items-center gap-4 border-b py-5 transition-colors sm:grid-cols-[1fr_auto] sm:gap-6"
>
  <span class="min-w-0">
    <span
      class="font-display text-ink group-hover:text-signal block truncate text-lg transition-colors mb-1"
    >
      {title}
    </span>
    <span class="text-ink-soft hidden truncate text-sm sm:block">{summary}</span>
  </span>

  <span
    aria-hidden="true"
    class="text-ink-soft group-hover:text-signal transition-all group-hover:translate-x-1"
  >
    →
  </span>
</a>
